# Nexus — variables de entorno (plantilla).
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repositorio.
# Sólo variables con prefijo VITE_ llegan al cliente y jamás deben contener secretos.
# La anon key de Supabase es pública por diseño (protegida por Row Level Security).

VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY_PUBLICA"
