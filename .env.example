# Nexus — variables de entorno (plantilla).
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repositorio.
# Sólo variables con prefijo VITE_ llegan al cliente y jamás deben contener secretos.
# La anon key de Supabase es pública por diseño (protegida por Row Level Security).

VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY_PUBLICA"

# Interruptor SÓLO de desarrollo: puentea el login para revisar pantallas
# protegidas sin iniciar sesión. Déjalo en "false" (o quítalo) para producción.
# Los datos siguen protegidos por RLS en la base aunque esté en "true".
VITE_AUTH_DISABLED="false"

# Auto-login de desarrollo (OPCIONAL). Si defines estas dos con una cuenta de
# PRUEBA, la app inicia sesión sola en modo dev y así se pueden probar los
# flujos que guardan datos. Nunca en producción; nunca uses tu cuenta real.
VITE_DEV_USER_EMAIL=""
VITE_DEV_USER_PASSWORD=""
