{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs", "src/**/index.ts"],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs"],
  "ignore": ["src/core/supabase/database.types.ts"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "ignoreExportsUsedInFile": true
}
